# Copy to .env in project root (never commit .env)
#
# IMPORTANT: Use a CLASSIC token with read:user scope for private contributions.
# Fine-grained "Profile" tokens often return public-only heatmap data.
#
# Create at: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Check ONLY: read:user
#
GH_CONTRIBUTIONS_TOKEN=ghp_your_classic_token_here
